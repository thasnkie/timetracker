/* Admin Dashboard Styles */
.admin-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 1rem;
  color: white;
}

.admin-header {
  max-width: 1200px;
  margin: 0 auto 2rem;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 2rem;
}

.admin-title-section h1 {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
  text-shadow: 0 2px 4px rgba(0,0,0,0.3);
}

.admin-welcome {
  color: rgba(255,255,255,0.8);
  font-size: 1rem;
  margin: 0;
}

.admin-nav {
  flex-shrink: 0;
}

.back-button {
  background: rgba(255,255,255,0.1);
  color: white;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 8px;
  padding: 0.75rem 1.5rem;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.3s ease;
  text-decoration: none;
  display: inline-block;
}

.back-button:hover {
  background: rgba(255,255,255,0.2);
  transform: translateX(-2px);
}

.access-denied {
  max-width: 600px;
  margin: 5rem auto;
  text-align: center;
  background: rgba(255,255,255,0.1);
  border-radius: 16px;
  padding: 3rem 2rem;
}

.access-denied h1 {
  font-size: 2.5rem;
  margin-bottom: 1rem;
  text-shadow: 0 2px 4px rgba(0,0,0,0.3);
}

.access-denied p {
  margin-bottom: 1rem;
  opacity: 0.9;
  font-size: 1.1rem;
}

.admin-controls {
  max-width: 1200px;
  margin: 0 auto 2rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  align-items: center;
}

.view-tabs {
  display: flex;
  gap: 0.5rem;
  background: rgba(255,255,255,0.1);
  border-radius: 12px;
  padding: 0.25rem;
}

.tab {
  background: transparent;
  color: white;
  border: none;
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s ease;
  font-weight: 500;
}

.tab:hover {
  background: rgba(255,255,255,0.1);
}

.tab.active {
  background: white;
  color: #667eea;
  font-weight: 600;
}

.date-picker {
  background: white;
  border: none;
  border-radius: 8px;
  padding: 0.75rem;
  font-size: 1rem;
  color: #333;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 3rem;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid rgba(255,255,255,0.3);
  border-top: 3px solid white;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* Users Section */
.users-section {
  max-width: 1200px;
  margin: 0 auto;
}

.users-section h2 {
  margin-bottom: 1.5rem;
  text-align: center;
}

.users-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1rem;
}

.user-card {
  background: white;
  color: #333;
  border-radius: 12px;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  box-shadow: 0 4px 16px rgba(0,0,0,0.1);
}

.user-avatar {
  font-size: 2rem;
  background: #f0f0f0;
  width: 60px;
  height: 60px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-info .user-name {
  font-weight: 600;
  font-size: 1.1rem;
  margin-bottom: 0.25rem;
}

.user-info .user-email {
  color: #666;
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
}

.user-info .user-last-seen {
  color: #888;
  font-size: 0.8rem;
}

/* Entries Section */
.entries-section {
  max-width: 1200px;
  margin: 0 auto;
}

.entries-summary h2 {
  text-align: center;
  margin-bottom: 1.5rem;
}

.daily-summary {
  background: rgba(255,255,255,0.1);
  border-radius: 12px;
  padding: 1.5rem;
  margin-bottom: 2rem;
}

.daily-summary h3 {
  margin-bottom: 1rem;
  text-align: center;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1rem;
}

.summary-card {
  background: white;
  color: #333;
  border-radius: 8px;
  padding: 1rem;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.summary-user {
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.summary-time {
  font-size: 1.25rem;
  font-weight: 700;
  color: #667eea;
}

/* Entries Table */
.entries-table {
  background: white;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(0,0,0,0.1);
}

.table-header {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr 2fr;
  gap: 1rem;
  background: #f8f9fa;
  padding: 1rem;
  font-weight: 600;
  color: #333;
  border-bottom: 1px solid #e9ecef;
}

.table-row {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr 2fr;
  gap: 1rem;
  padding: 1rem;
  border-bottom: 1px solid #f0f0f0;
  color: #333;
  align-items: center;
}

.table-row:last-child {
  border-bottom: none;
}

.table-row:hover {
  background: #f8f9fa;
}

.user-cell .user-name {
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.user-cell .user-email {
  font-size: 0.9rem;
  color: #666;
}

.action-cell {
  font-weight: 600;
}

.action-cell.clock-in {
  color: #4CAF50;
}

.action-cell.clock-out {
  color: #f44336;
}

.date-cell, .time-cell {
  font-variant-numeric: tabular-nums;
}

.location-cell {
  font-size: 0.9rem;
}

.location-address {
  color: #4CAF50;
  font-weight: 500;
  cursor: help;
}

.location-coordinates {
  color: #FF9800;
  font-weight: 500;
  cursor: help;
  font-family: monospace;
}

.location-unavailable {
  color: #9E9E9E;
  font-style: italic;
}

.no-data {
  text-align: center;
  padding: 3rem;
  color: rgba(255,255,255,0.8);
}

/* Responsive Design */
@media (max-width: 768px) {
  .admin-controls {
    align-items: stretch;
  }
  
  .view-tabs {
    flex-direction: column;
  }
  
  .table-header,
  .table-row {
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }
  
  .table-header span,
  .table-row > div {
    padding: 0.5rem 0;
  }
  
  .table-header {
    display: none;
  }
  
  .table-row {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .table-row > div::before {
    content: attr(data-label);
    font-weight: bold;
    margin-right: 0.5rem;
    color: #666;
  }
  
  .summary-grid {
    grid-template-columns: 1fr;
  }
  
  .users-grid {
    grid-template-columns: 1fr;
  }
}